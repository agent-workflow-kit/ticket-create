{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-create/hooks/post-create.json",
  "title": "post-create hook payload (stdin)",
  "description": "After the create and sprint steps. attempt and dedupe_key are null for a sprint-only run. event_id is fresh per invocation. No repo or labels key (the draft has a repo; it is not part of the payload). No title, body, notes or other model text.",
  "type": "object",
  "properties": {
    "tool": {
      "const": "ticket-create"
    },
    "hook": {
      "const": "post-create"
    },
    "object_type": {
      "const": "draft"
    },
    "object_id": {
      "$ref": "../defs.json#/$defs/draft_id"
    },
    "result": {
      "enum": [
        "created",
        "reused",
        "partial",
        "failed",
        "unknown"
      ]
    },
    "site": {
      "$ref": "../defs.json#/$defs/site"
    },
    "project": {
      "$ref": "../defs.json#/$defs/project"
    },
    "key": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/ticket_key"
        },
        {
          "type": "null"
        }
      ]
    },
    "sprint_step": {
      "$ref": "../defs.json#/$defs/sprint_step"
    },
    "attempt": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "n": {
              "type": "integer",
              "minimum": 1
            },
            "plan_sha256": {
              "$ref": "../defs.json#/$defs/sha256"
            }
          },
          "required": [
            "n",
            "plan_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "event_id": {
      "$ref": "../defs.json#/$defs/event_id"
    },
    "dedupe_key": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/dedupe_key"
        },
        {
          "type": "null"
        }
      ]
    },
    "reads_third_party": {
      "const": false
    },
    "tainted": {
      "const": false
    }
  },
  "required": [
    "tool",
    "hook",
    "object_type",
    "object_id",
    "result",
    "site",
    "project",
    "key",
    "sprint_step",
    "attempt",
    "event_id",
    "dedupe_key",
    "reads_third_party",
    "tainted"
  ],
  "additionalProperties": false
}
