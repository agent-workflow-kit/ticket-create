{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-create/audit.json",
  "title": "ticket-create audit.jsonl record",
  "description": "Public, append-only. An attempted record before each ticketctl create --yes and sprint add --yes call and an outcome record after it, paired by attempt_id (ticket-create's own; null on a draft run record), plus one outcome record per draft run. No title, body, notes or model text, no secrets.",
  "type": "object",
  "properties": {
    "ts": {
      "$ref": "defs.json#/$defs/ts"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "enum": [
        "attempted",
        "outcome"
      ]
    },
    "attempt_id": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/attempt_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "$ref": "defs.json#/$defs/actor"
    },
    "decision_id": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/decision_id"
        },
        {
          "$ref": "defs.json#/$defs/decision_ids"
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "enum": [
        "create",
        "sprint_add",
        "draft"
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}/[A-Z][A-Z0-9_]*$",
          "description": "<site>/<project> Full match."
        },
        {
          "$ref": "defs.json#/$defs/draft_id"
        }
      ]
    },
    "inputs": {
      "type": "object",
      "properties": {
        "draft_id": {
          "$ref": "defs.json#/$defs/draft_id"
        },
        "dedupe_key": {
          "$ref": "defs.json#/$defs/dedupe_key"
        },
        "plan_sha256": {
          "$ref": "defs.json#/$defs/sha256"
        },
        "body_sha256": {
          "$ref": "defs.json#/$defs/sha256"
        },
        "origin": {
          "$ref": "defs.json#/$defs/origin"
        },
        "overrides": {
          "$ref": "defs.json#/$defs/overrides"
        },
        "override_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "override_escalation": {
          "oneOf": [
            {
              "enum": [
                "ticketctl"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_id": {
          "$ref": "defs.json#/$defs/agent_id"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "key": {
              "oneOf": [
                {
                  "$ref": "defs.json#/$defs/ticket_key"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reused": {
              "type": "boolean"
            },
            "ticketctl_attempt_id": {
              "oneOf": [
                {
                  "$ref": "defs.json#/$defs/ticketctl_attempt_id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "outcome": {
              "enum": [
                "attempted",
                "created",
                "reused",
                "accepted",
                "failed",
                "unknown",
                "done",
                "ready",
                "abandoned"
              ]
            },
            "code": {
              "oneOf": [
                {
                  "$ref": "defs.json#/$defs/code"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "outcome"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "ts",
    "seq",
    "phase",
    "attempt_id",
    "actor",
    "decision_id",
    "action",
    "target",
    "inputs",
    "result"
  ],
  "additionalProperties": false
}
